# .htaccess — TSOGZ (CourseWorkIkeaShop_2026)
# DocumentRoot = repo root (see docker-compose.yml: `.:/var/www/html`)

RewriteEngine On
RewriteBase /

# ------------------------------------------------------------------
# Never serve these directly over HTTP.
# ------------------------------------------------------------------
RewriteRule ^\.env$ - [F,L]
RewriteRule ^sql/ - [F,L]
RewriteRule ^Backend/Scripts/ - [F,L]
RewriteRule ^docker-compose\.yml$ - [F,L]

# ------------------------------------------------------------------
# API — everything under /api/ goes through the front controller.
# Backend/Api/index.php parses the full request path itself, so a
# single catch-all rewrite is enough; QSA keeps ?type=, ?slug=, etc.
# ------------------------------------------------------------------
RewriteRule ^api/(.*)$ Backend/Api/index.php [L,QSA]

# ------------------------------------------------------------------
# Pages — flat URLs (e.g. /portfolio.html) map to Front/Pages/.
# Keeping the URLs flat means the existing relative links between
# pages (href="portfolio.html", href="styles.css", etc.) keep working
# unchanged.
# ------------------------------------------------------------------
RewriteRule ^$ Front/Pages/index.html [L]
RewriteRule ^styles\.css$ Front/Pages/styles.css [L]
RewriteRule ^js/(.+)$ Front/Pages/js/$1 [L]
RewriteRule ^([a-z0-9-]+)\.html$ Front/Pages/$1.html [L]

# /Assets/* are real files at the repo root already — no rewrite needed.

# ------------------------------------------------------------------
# Anything else that isn't a real file/dir → 404.
# ------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ - [R=404,L]
